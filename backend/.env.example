# Neon Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# Google Sign-In (Web client ID used to verify idToken)
GOOGLE_CLIENT_ID=""
GOOGLE_WEB_CLIENT_ID=""

# SMTP (forgot password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FitNova AI <noreply@example.com>"
APP_URL="http://localhost:4000"
SUPPORT_EMAIL="support@example.com"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Server
PORT=4000
CORS_ORIGIN="*"
NODE_ENV="development"

# Railway: mount a volume and set this to the mount path (e.g. /data/uploads)
# so profile photos survive redeploys. Leave empty for local ./uploads
UPLOADS_DIR=""
