# Copy to keystore.properties (gitignored) and fill in real values.
# Generate an upload keystore:
#   keytool -genkeypair -v -storetype PKCS12 -keystore upload-keystore.jks \
#     -alias fitnova-upload -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the android/ directory.

storeFile=app/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=fitnova-upload
keyPassword=CHANGE_ME
